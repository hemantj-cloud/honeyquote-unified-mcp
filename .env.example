# Server & Transport
PORT=3000
NODE_ENV=production
MCP_TRANSPORT_TYPE=dual

# HoneyQuote QA API (Quoting & SwarmValuation)
MCP_API_BASE_URL=https://mcp-server-qa.cda7df0f963e4a14a920.eastus.aksapp.io/api/v1
MCP_API_CLIENT_ID=your_client_id_here

# Persistence (Direct MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=hq_demo
SEED_ON_STARTUP=false

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Identity & OTP (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_VERIFY_SERVICE_SID=VA...
DEFAULT_CUSTOMER_PHONE=+919503760623
VALID_OTP_CODES=489923,182055,772901,624993,492011

# Outbound Email (Gmail API)
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
DEMO_CUSTOMER_EMAIL=user@example.com

# Outbound Slack / Underwriting Escalation (HITL)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Interactive Next.js Widgets
WIDGETS_DEV_MODE=false
WIDGETS_DEV_PORT=3001
