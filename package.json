{
  "name": "honeyquote-unified-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HoneyQuote Unified Clean MCP Server (16 Production Tools)",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "widgets:serve": "node ./scripts/serve-widget-dev.mjs",
    "seed": "tsx scripts/seed.ts",
    "reseed": "tsx scripts/seed.ts",
    "test:tools": "tsx scripts/test-all-16-tools.ts",
    "test:smoke": "tsx scripts/smoke-test-tools.ts",
    "test:otp": "node ./scripts/test_otp_flow.mjs",
    "verify:mcp": "tsx scripts/verify-unified-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": ">=0.1.0",
    "@nitrostack/core": "^1.0.8",
    "dotenv": "^16.3.1",
    "mongodb": "^6.5.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
